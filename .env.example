# tab, in plaintext (confirmed — see vault/01-Architecture/API-Inventory.md,
# docs/risk-register.md R2) — NOT Script Properties, despite what you'd
# expect. Groq/GitHub Models storage location: unconfirmed, don't assume. ---
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=

